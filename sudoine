#!/usr/bin/env python3
"""sudoine - let an AI run sudo commands without ever seeing your password.

  sudoine enable [--timeout MIN]   ask for the password once, start the background broker
  sudoine <command...>             run `sudo <command...>` in its own background terminal
  sudoine status                   is it enabled?
  sudoine disable                  kill the broker (and every running command); password forgotten

The password lives only in the broker's memory. Each command gets its own
pseudo-terminal, so many can run at once. Closing the broker closes the terminals.
"""
import fcntl, getpass, json, os, pty, select, shutil, signal, socket, socketserver
import struct, subprocess, sys, termios, threading

# ---------------------------------------------------------------- paths
def rundir():
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    d = os.path.join(xdg, "sudoine") if xdg else f"/tmp/sudoine-{os.getuid()}"
    os.makedirs(d, mode=0o700, exist_ok=True)
    st = os.stat(d)
    if st.st_uid != os.getuid() or st.st_mode & 0o077:
        sys.exit(f"sudoine: {d} is not private to you; refusing to use it")
    return d

def sock_path():
    return os.path.join(rundir(), "sock")

# ---------------------------------------------------------------- framing
def send(conn, kind, data=b""):
    conn.sendall(kind + struct.pack(">I", len(data)) + data)

def connect():
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(sock_path())
        return s
    except OSError:
        s.close()
        return None

def request(s, obj):
    s.sendall(json.dumps(obj).encode() + b"\n")

# ---------------------------------------------------------------- client
def cmd_run(argv):
    s = connect()
    if not s:
        sys.exit("sudoine: not enabled. Ask the user to run: sudoine enable")
    request(s, {"op": "run", "argv": argv, "cwd": os.getcwd(),
                "cols": shutil.get_terminal_size((200, 50)).columns})
    f = s.makefile("rb")
    out = sys.stdout.buffer
    try:
        while True:
            hdr = f.read(5)
            if len(hdr) < 5:
                sys.exit("sudoine: connection to broker lost")
            n = struct.unpack(">I", hdr[1:])[0]
            data = f.read(n)
            if hdr[:1] == b"o":
                out.write(data); out.flush()
            elif hdr[:1] == b"e":
                sys.exit("sudoine: " + data.decode(errors="replace"))
            elif hdr[:1] == b"x":
                return int(data)
    except KeyboardInterrupt:
        return 130          # closing the socket hangs up the background terminal
    except BrokenPipeError:
        return 141

def cmd_status():
    s = connect()
    if not s:
        print("sudoine: disabled"); return 1
    request(s, {"op": "ping"}); s.makefile("rb").read(5)
    print("sudoine: enabled"); return 0

def cmd_disable():
    s = connect()
    if not s:
        print("sudoine: already disabled"); return 0
    request(s, {"op": "quit"})
    s.makefile("rb").read()      # returns when the broker closes the connection
    print("sudoine: disabled"); return 0

def cmd_enable(argv):
    minutes = None
    if argv[:1] == ["--timeout"] and len(argv) == 2:
        minutes = float(argv[1])
    elif argv:
        sys.exit("usage: sudoine enable [--timeout MINUTES]")
    if connect():
        print("sudoine: already enabled"); return 0
    sudo = shutil.which("sudo") or sys.exit("sudoine: sudo not found")
    pw = bytearray(getpass.getpass(f"[sudoine] sudo password for {getpass.getuser()}: ").encode())
    r = subprocess.run([sudo, "-S", "-p", "", "-k", "-v"], input=bytes(pw) + b"\n",
                       capture_output=True)
    if r.returncode != 0:
        sys.exit("sudoine: wrong password (or you are not allowed to use sudo)")
    rd, wr = os.pipe()
    if os.fork():                                # parent: wait until the broker is listening
        os.close(wr)
        ok = os.read(rd, 1)
        for i in range(len(pw)): pw[i] = 0
        if not ok:
            sys.exit("sudoine: broker failed to start")
        print("sudoine: enabled" + (f" (auto-disables in {minutes:g} min)" if minutes else "")
              + ". Run commands with: sudoine <command>")
        return 0
    os.close(rd)
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    serve(bytes(pw), sudo, minutes, wr)
    os._exit(0)

# ---------------------------------------------------------------- broker
BOOT = ("import os,sys,fcntl,termios;os.setsid();"
        "fcntl.ioctl(1,termios.TIOCSCTTY,0);os.execvp(sys.argv[1],sys.argv[1:])")

def serve(pw, sudo, minutes, ready_fd):
    live, lock = set(), threading.Lock()

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            _, uid, _ = struct.unpack("3i", self.request.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
            if uid != os.getuid():
                return
            try:
                req = json.loads(self.rfile.readline(1 << 20))
            except ValueError:
                return
            op = req.get("op")
            if op == "ping":
                send(self.request, b"x", b"0")
            elif op == "quit":
                threading.Thread(target=server.shutdown).start()
            elif op == "run":
                self.run(req)

        def run(self, req):
            conn = self.request
            argv = req.get("argv") or []
            if not argv or not all(isinstance(a, str) for a in argv):
                return send(conn, b"e", b"no command given")
            master, slave = pty.openpty()
            a = termios.tcgetattr(slave)
            a[1] &= ~termios.OPOST      # no \n -> \r\n
            a[3] &= ~termios.ECHO
            termios.tcsetattr(slave, termios.TCSANOW, a)
            cols = int(req.get("cols") or 200)
            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 50, cols, 0, 0))
            try:
                proc = subprocess.Popen(
                    [sys.executable, "-I", "-c", BOOT, sudo, "-S", "-p", "", "-k", "--", *argv],
                    stdin=subprocess.PIPE, stdout=slave, stderr=slave,
                    cwd=req.get("cwd") or None, close_fds=True)
            except OSError as e:
                os.close(master); os.close(slave)
                return send(conn, b"e", str(e).encode())
            os.close(slave)
            with lock: live.add(master)
            try:
                try:
                    proc.stdin.write(pw + b"\n"); proc.stdin.close()
                except OSError:
                    pass
                gone = False
                while True:
                    r, _, _ = select.select([master, conn], [], [], 0.2)
                    if conn in r:
                        gone = True         # client went away -> hang up the terminal
                        break
                    if master in r:
                        try:
                            data = os.read(master, 65536)
                        except OSError:
                            data = b""
                        if not data:
                            break
                        send(conn, b"o", data)
                    elif proc.poll() is not None:
                        break
                if not gone:
                    rc = proc.wait()
                    send(conn, b"x", str(rc if rc >= 0 else 128 - rc).encode())
            except (BrokenPipeError, ConnectionError):
                pass
            finally:
                with lock: live.discard(master)
                try: os.close(master)
                except OSError: pass
                threading.Thread(target=proc.wait, daemon=True).start()

    class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    path = sock_path()
    try: os.unlink(path)
    except FileNotFoundError: pass
    os.umask(0o177)
    server = Server(path, Handler)
    os.chmod(path, 0o600)

    def stop(*_):
        threading.Thread(target=server.shutdown).start()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    if minutes:
        t = threading.Timer(minutes * 60, stop); t.daemon = True; t.start()
    os.write(ready_fd, b"1"); os.close(ready_fd)
    try:
        server.serve_forever()
    finally:
        with lock:
            for m in list(live):            # closing a master hangs up its terminal
                try: os.close(m)
                except OSError: pass
        server.server_close()
        try: os.unlink(path)
        except OSError: pass

# ---------------------------------------------------------------- main
def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    if a[0] == "enable":  return cmd_enable(a[1:])
    if a[0] == "disable": return cmd_disable()
    if a[0] == "status":  return cmd_status()
    return cmd_run(a)

if __name__ == "__main__":
    sys.exit(main())
